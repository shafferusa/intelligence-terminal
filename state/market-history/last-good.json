 "fomc_20260916": {
  "date": "2026-09-16",
  "decision": "Raised federal funds rate target range 25bp to 3.75%-4.00% (from 3.50%-3.75%), effective 2026-09-17. First hike since July 2023.",
  "vote": "12-0 unanimous (per Fed statement / multiple wire reports)",
  "primary_confirm_1": "https://www.federalreserve.gov/newsevents/pressreleases/monetary20260916a.htm (FOMC statement)",
  "primary_confirm_2": "https://www.federalreserve.gov/newsevents/pressreleases/monetary20260916a1.htm (Implementation Note: target range 3.75-4.00%, reserve balance rate 3.90%, primary credit rate 4.00%)",
