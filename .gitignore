# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
._*

# Python
__pycache__/
*.pyc
*.pyo

# Node
node_modules/

# Secrets / local env — credentials must NEVER be committed
.env
.env.*

# Local agent tooling scratch (worktrees for background research agents, etc.)
# is ignored, except the shared settings.json: it carries the read-only permission
# allowlist, and cloud sessions only see it if it is committed.
.claude/*
!.claude/settings.json
